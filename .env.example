# ============ Pengembangan lokal ============
DEBUG=True
COOKIE_SECURE=False
# SECRET_KEY=isi-kalau-mau-beda-dari-default
# GEMINI_API_KEY=untuk-fitur-rekomendasi-KBLI-AI (opsional)

# ============ Produksi / Vercel ============
# Semua di bawah ini diisi lewat Environment Variables di dashboard Vercel,
# BUKAN lewat file .env (file .env tidak diunggah ke Vercel).
#
# SECRET_KEY=<acak, minimal 50 karakter>
# DEBUG=False
# COOKIE_SECURE=True
# ALLOWED_HOSTS=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://domain-anda.com      (kalau pakai domain sendiri)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DB_CONN_MAX_AGE=0
